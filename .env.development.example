# ============================================================
# CrimeKit Development Environment Configuration
# ============================================================
# Copy this file to .env.development for local development
# These defaults are intentionally loose for convenience
# ============================================================

# --- Application ---
APP_NAME=CrimeKit
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=dev-secret-key-do-not-use-in-production
APP_LOG_LEVEL=debug

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
UVICORN_WORKERS=1

# --- Database (PostgreSQL) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=crimekit
POSTGRES_USER=crimekit_app
POSTGRES_PASSWORD=crimekit_dev
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev
REDIS_DB=0
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# --- Neo4j ---
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_dev

# --- MinIO (S3-compatible) ---
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=miniodev
MINIO_SECRET_KEY=miniodev123
MINIO_BUCKET_EVIDENCE=crimekit-evidence
MINIO_BUCKET_DOCUMENTS=crimekit-documents
MINIO_BUCKET_BACKUPS=crimekit-backups
MINIO_BUCKET_AI_OUTPUTS=crimekit-ai-outputs
MINIO_BUCKET_COURT_REPORTS=crimekit-court-reports
MINIO_USE_SSL=false

# --- JWT Authentication ---
JWT_SECRET_KEY=dev-jwt-secret-do-not-use-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# --- AI Pipeline ---
EMBEDDING_PROVIDER=deterministic
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Nginx ---
NGINX_WORKER_PROCESSES=1
NGINX_WORKER_CONNECTIONS=1024

# --- Monitoring ---
PROMETHEUS_RETENTION_DAYS=7
GRAFANA_ADMIN_PASSWORD=admin

# --- Backup ---
BACKUP_DIR=/backups
BACKUP_RETENTION_DAYS=7

# --- Testing ---
TESTING=0

# ============================================================
# OPTIONAL SERVICES (enable in docker-compose)
# ============================================================
# Uncomment or add these to your compose profile:
#
# PGADMIN:
#   Enable the pgadmin service for a web-based Postgres GUI.
#   Access at http://localhost:5050
#   Default login: admin@admin.com / admin
#
# NEO4J_BROWSER:
#   Enable the neo4j-browser service for Cypher query UI.
#   Access at http://localhost:7474
#   Default login: neo4j / neo4j_dev
#
# REDIS_COMMANDER:
#   Enable the redis-commander service for a Redis GUI.
#   Access at http://localhost:8081
#
# MINIO_CONSOLE:
#   MinIO console is available at http://localhost:9001
#   Default login: miniodev / miniodev123
# ============================================================
