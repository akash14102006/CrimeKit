# ============================================================
# CrimeKit — Unified Environment Configuration Specification
# ============================================================
# Copy this file to .env and customize for your environment.
# NEVER commit .env to version control.
# ============================================================

# --- Application ---
APP_NAME=CrimeKit
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=CHANGE_ME_TO_RANDOM_64_CHARS
APP_LOG_LEVEL=info
APP_VERSION=1.0.0

# --- Frontend (Client-side) ---
NEXT_PUBLIC_API_URL=http://localhost:8002
NEXT_PUBLIC_APP_NAME=CrimeKit
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8002
UVICORN_WORKERS=2
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8000,http://localhost:8002,http://127.0.0.1:3000,http://127.0.0.1:3001

# --- Database (PostgreSQL 16 with pgvector) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=crimekit
POSTGRES_USER=crimekit_app
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# --- Redis (Cache, Streams Task Queue, & Realtime Pub/Sub) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_IN_PRODUCTION
REDIS_DB=0
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# --- Knowledge Graph (Neo4j) ---
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME_IN_PRODUCTION

# --- Object Storage (MinIO local / AWS S3 Production) ---
STORAGE_PROVIDER=minio
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=CHANGE_ME_IN_PRODUCTION
MINIO_SECRET_KEY=CHANGE_ME_IN_PRODUCTION
MINIO_BUCKET_EVIDENCE=crimekit-evidence
MINIO_BUCKET_DOCUMENTS=crimekit-documents
MINIO_BUCKET_BACKUPS=crimekit-backups
MINIO_BUCKET_AI_OUTPUTS=crimekit-ai-outputs
MINIO_BUCKET_COURT_REPORTS=crimekit-court-reports
MINIO_USE_SSL=false
EVIDENCE_STORAGE_DIR=/app/backend/storage/evidence

# --- JWT Authentication & RBAC ---
JWT_SECRET_KEY=CHANGE_ME_TO_RANDOM_64_CHARS
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- AI & Vector Pipeline ---
EMBEDDING_PROVIDER=deterministic
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
VECTOR_STORE_BACKEND=database

# --- Nginx & Reverse Proxy ---
NGINX_WORKER_PROCESSES=auto
NGINX_WORKER_CONNECTIONS=4096

# --- Monitoring & Observability ---
PROMETHEUS_RETENTION_DAYS=30
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_IN_PRODUCTION

# --- Forensic Evidence Retention & Backups ---
BACKUP_DIR=/backups
BACKUP_RETENTION_DAYS=30

# --- Testing Mode Flag ---
TESTING=0
