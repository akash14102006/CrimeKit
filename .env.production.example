# ============================================================
# CrimeKit Production Environment Configuration
# ============================================================
# Copy this file to .env.production and customize
# This file MUST be treated as a secret
# ============================================================
# SECURITY NOTES:
#   - Store secrets in a secrets manager (HashiCorp Vault, AWS
#     Secrets Manager, Azure Key Vault, etc.)
#   - Never commit this file to version control
#   - Use strong, unique passwords (20+ characters, mixed case,
#     symbols, and numbers)
#   - Generate JWT_SECRET_KEY and APP_SECRET_KEY with a CSPRNG
#   - Rotate credentials on a regular schedule
#   - Limit network access to Neo4j, Postgres, and Redis to
#     only the application subnet
# ============================================================

# --- Application ---
APP_NAME=CrimeKit
APP_ENV=production
APP_DEBUG=false
APP_SECRET_KEY=CHANGE_ME_TO_RANDOM_64_CHARS
APP_LOG_LEVEL=warning

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
UVICORN_WORKERS=4

# --- Database (PostgreSQL) ---
# Use a managed database in production (RDS, Cloud SQL, Azure DB)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=crimekit
POSTGRES_USER=crimekit_app
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# --- Redis ---
# Increase maxmemory for production workloads
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_IN_PRODUCTION
REDIS_DB=0
REDIS_MAXMEMORY=1g
REDIS_MAXMEMORY_POLICY=allkeys-lru
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# --- Neo4j ---
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME_IN_PRODUCTION

# --- MinIO (S3-compatible) ---
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=CHANGE_ME_IN_PRODUCTION
MINIO_SECRET_KEY=CHANGE_ME_IN_PRODUCTION
MINIO_BUCKET_EVIDENCE=crimekit-evidence
MINIO_BUCKET_DOCUMENTS=crimekit-documents
MINIO_BUCKET_BACKUPS=crimekit-backups
MINIO_BUCKET_AI_OUTPUTS=crimekit-ai-outputs
MINIO_BUCKET_COURT_REPORTS=crimekit-court-reports
MINIO_USE_SSL=true

# --- JWT Authentication ---
JWT_SECRET_KEY=CHANGE_ME_TO_RANDOM_64_CHARS
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- AI Pipeline ---
EMBEDDING_PROVIDER=deterministic
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Nginx ---
NGINX_WORKER_PROCESSES=auto
NGINX_WORKER_CONNECTIONS=4096

# --- Monitoring ---
PROMETHEUS_RETENTION_DAYS=30
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_IN_PRODUCTION

# --- Backup ---
BACKUP_DIR=/backups
BACKUP_RETENTION_DAYS=30

# --- Testing ---
TESTING=0
